# DeBank Cloud AccessKey (https://cloud.debank.com) — enables importing DeFi positions by wallet address.
DEBANK_ACCESS_KEY=
# Set to 1 to use built-in demo data for DeBank sync when you have no key.
DEBANK_MOCK=0
# Optional: protect the app with HTTP basic auth (any username, this password).
APP_PASSWORD=
# Optional: custom Solana RPC (default: public mainnet-beta endpoint).
SOLANA_RPC_URL=
# Zerion API key (https://dashboard.zerion.io) — EVM DeFi positions + Solana token balances.
ZERION_API_KEY=
# Set to 1 to use built-in demo data for Zerion sync when you have no key.
ZERION_MOCK=0
# Extended (extended.exchange) read-only API key — Extended → API management. Gives perps equity + net deposits.
EXTENDED_API_KEY=
# Optional: attach the Extended account to one wallet address (when you track several wallets).
EXTENDED_WALLET_ADDRESS=
# Lighter is public (no key). Set to 1 to turn it off.
LIGHTER_DISABLED=0
# Re-sync all wallets from every connected source every N hours (0 = off). Each sync adds a history point.
AUTO_SYNC_HOURS=12
